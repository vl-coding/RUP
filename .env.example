# This project originally hard-coded credentials inline. They have been
# externalized to environment variables so no secrets live in the source.
#
# The repo is published as a CODE / LOGIC SHOWCASE, not a runnable product,
# so these values are intentionally left blank.

# LLM providers (address classification)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Gmail (clock-in/out confirmation + notifications) — use a Google app password
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Outlook / Microsoft 365 shared mailbox — use an app password
OUTLOOK_APP_PASSWORD=

# Rutgers HRMS (automated time clock)
RUTGERS_NETID=
RUTGERS_PASSWORD=

# BiblioVault (electronic comp-copy link generation)
BIBLIOVAULT_USERNAME=
BIBLIOVAULT_PASSWORD=

# Firebrand Title Management (launch-notes entry)
FIREBRAND_USERNAME=
FIREBRAND_PASSWORD=

# Chicago Distribution Center (print desk-copy orders)
CDC_USERNAME=
CDC_PASSWORD=
